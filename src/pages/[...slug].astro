---
import Layout from '../components/Layout.astro';
import Month from '../components/Month.astro';
import Converter from '../components/Converter.astro';
import Birthday from '../components/Birthday.astro';
import FestivalActions from '../components/FestivalActions.astro';
import { festivalChecked, verifiedFestivals } from '../lib/verified-festivals';
import { pages } from '../lib/routes';
import { sources } from '../data/evidence';
import { methods, months, toGregorian } from '../lib/bengali';
import { bn, gregorianLabel } from '../lib/dates';
import { correctionEmail, gregorianSlugs, unavailable, years } from '../lib/site';
export function getStaticPaths() {
  return pages.map(page => ({params:{slug:page.slug},props:{page}}));
}
const { page } = Astro.props;
const publicEmail = correctionEmail ?? 'boosad.96.abhi@gmail.com';
const period = page.month ? [page.month] : Array.from({length:12},(_,i)=>i+1);
const festivalIndex = page.slug === 'festivals' || page.slug === 'festivals/2027';
const sourceLabels = {
  pacSolar:'রাষ্ট্রীয় পঞ্চাঙ্গ · আঞ্চলিক সৌর বর্ষপঞ্জি',
  pacHorizon:'রাষ্ট্রীয় পঞ্চাঙ্গ · উদয় ও অস্তের সারণি',
  rkm:'রামকৃষ্ণ মিশন · পঞ্জিকা পাঠ',
  bdRules:'শিক্ষক বাতায়ন · বাংলাদেশের সংশোধিত বর্ষপঞ্জি',
  bdReport:'বাংলাদেশের বর্ষপঞ্জি সংস্কারের সমকালীন প্রতিবেদন',
};
---
<Layout title={page.title} description={page.description} noindex={page.noindex} festival={page.festival} preloadBengali={Boolean(page.festival) || page.kind === 'converter'} stableFont={page.kind === 'converter'}>
  <h1>{page.title}</h1>
  <p class="muted">{page.description}</p>
  {page.festival && <section class="section card">
    <dl>
      <dt>গ্রেগরিয়ান তারিখ</dt><dd><time datetime={page.festival.date}>{gregorianLabel(page.festival.date)}</time></dd>
      <dt>বাংলা তারিখ</dt><dd>{page.festival.bengaliDate} · {page.festival.calendar}</dd>
      <dt>স্থান</dt><dd>পশ্চিমবঙ্গ</dd>
      <dt>যাচাইয়ের তারিখ</dt><dd>{gregorianLabel(festivalChecked)}</dd>
    </dl>
    <h2>দিনটি কীভাবে যাচাই করা হয়েছে</h2>
    <p>{page.festival.rule}</p>
    {page.festival.slug === 'pohela-boishakh' && <p>এই উৎসবের পশ্চিমবঙ্গের সৌর বর্ষপঞ্জিতে ২০২৭ সালে নতুন বছর শুরু হয় ১৫ এপ্রিল। বাংলাদেশের সংশোধিত নাগরিক নিয়মে নববর্ষের তারিখ স্থির, ১৪ এপ্রিল।</p>}
    <p><a class="pill source-link" href={page.festival.source}>উৎস দেখুন</a></p>
    <FestivalActions date={page.festival.date} />
  </section>}
  {festivalIndex && <section class="section card">
    <h2>২০২৭ সালের যাচাইকৃত উৎসব · পশ্চিমবঙ্গ</h2>
    <ul class="festival-list">{verifiedFestivals.map(festival => <li>
      <a href={`/festivals/${festival.slug}/2027/`}>{festival.title}</a>
      <time datetime={festival.date}>{gregorianLabel(festival.date)}</time>
    </li>)}</ul>
    <p class="muted">অন্য উৎসবের তারিখ যাচাই হলে এই তালিকায় যোগ করা হবে।</p>
  </section>}
  {!festivalIndex && page.kind === 'pending' && <p class="notice">{unavailable}</p>}
  {page.kind === 'gregorian' && <nav class="pills section" aria-label="ক্যালেন্ডারের বছর বেছে নিন">
    {years.map(year => <a class="pill" aria-current={year === page.year ? 'page' : undefined}
      href={`/calendar/${year}/${page.month ? gregorianSlugs[page.month - 1] + '/' : ''}`}>{bn(year)}</a>)}
  </nav>}
  {page.links && (!festivalIndex || page.slug === 'festivals') && <nav class="pills section" aria-label="সংশ্লিষ্ট পাতা">{page.links.map(({href,label}) => <a class="pill" href={href}>{label}</a>)}</nav>}
  {page.kind === 'gregorian' && <section class:list={["section grid", {"annual-calendar-print annual-calendar": !page.month}]}>{period.map(month => <div class="card"><Month year={page.year!} {month} region="bangladesh" /></div>)}</section>}
  {page.kind === 'bengali' && <section class="section"><p>{methods.bangladesh}</p><div class="grid">{period.map(month => {
    const days = Array.from({length:31}, (_,i) => toGregorian({year:page.year!,month,day:i+1})).filter((date): date is string => Boolean(date));
    return <div class="card"><h2>{months[month-1]} {bn(page.year!)}</h2>
      <dl>{days.map((date,i) => <><dt>{bn(i+1)}</dt><dd><time datetime={date}>{gregorianLabel(date)}</time></dd></>)}</dl>
    </div>;
  })}</div></section>}
  {['bengali','gregorian','converter'].includes(page.kind) && <p class="section notice">পদ্ধতি · বাংলাদেশের সংশোধিত নাগরিক বর্ষপঞ্জি। <a href="/methodology/">নিয়ম দেখুন</a>। পশ্চিমবঙ্গের সৌর বর্ষপঞ্জির প্রকাশ অপেক্ষমাণ।</p>}
  {page.kind === 'converter' && <><div class="converter-grid"><Converter /></div><p class="actions"><a href="/tools/bengali-birthday/">বাংলা জন্মদিন</a><a href="/tools/age-calculator/">বয়স গণনা</a></p></>}
  {(page.kind === 'birthday' || page.kind === 'age') && <div class="birthday-tool"><Birthday /></div>}
  {page.slug === 'calendar/2027' && <p class="actions"><a href="/downloads/bangladesh-calendar-2027.pdf" download>ক্যালেন্ডারের পিডিএফ ডাউনলোড করুন</a></p>}
  {page.slug === 'sources' && <ul class="section">{Object.entries(sources).map(([key,source]) => <li><a href={source}>{sourceLabels[key as keyof typeof sourceLabels]}</a></li>)}</ul>}
  {page.slug === 'corrections' && <section class="section card"><h2>প্রকাশিত সংশোধন</h2><p>এখনও কোনো সংশোধন নথিভুক্ত হয়নি।</p>{correctionEmail ? <a href={`mailto:${correctionEmail}`}>সংশোধন জানান</a> : <p>সংশোধন পাঠানোর ঠিকানা এখনও চালু হয়নি।</p>}</section>}
  {page.slug === 'privacy' && <section class="section card" aria-label="গোপনীয়তা নীতি">
    <h2>সাইট ব্যবহার ও যোগাযোগ</h2>
    <p>বঙ্গপঞ্জি দেখতে কোনো অ্যাকাউন্ট বা নিবন্ধন লাগে না। তারিখ রূপান্তর ও জন্মদিনের হিসাব আপনার ব্রাউজারেই হয়। এই সরঞ্জামগুলিতে দেওয়া তথ্য বঙ্গপঞ্জি নিজের ডেটাবেসে জমা রাখে না। আমরা ব্যক্তিগত তথ্য বিক্রি করি না। ইমেলে যোগাযোগ করলে আপনার ঠিকানা ও বার্তা উত্তর দেওয়ার জন্য ব্যবহার করা হয়।</p>
    <h2>ব্যবহার-পরিসংখ্যান ও কুকি</h2>
    <p>কোন পাতা কতবার দেখা হয়, তা বোঝার জন্য বঙ্গপঞ্জি গুগল অ্যানালিটিক্স ৪ ব্যবহার করে। আমরা সামগ্রিক ব্যবহার-পরিসংখ্যান দেখি। গুগল অ্যানালিটিক্স ব্যবহার মাপতে কুকি ও ব্রাউজার শনাক্তকারী ব্যবহার করতে পারে। গুগল কীভাবে তথ্য ব্যবহার করে, তা <a href="https://policies.google.com/technologies/partner-sites?hl=bn">গুগলের তথ্য ব্যবহার নীতিতে</a> দেখুন।</p>
    <h2>বিজ্ঞাপন</h2>
    <p>বঙ্গপঞ্জিতে বর্তমানে গুগল অ্যাডসেন্স চালু নেই। ভবিষ্যতে চালু হলে গুগল বিজ্ঞাপন দেখানো বা ব্যক্তিগত পছন্দ অনুযায়ী বিজ্ঞাপন বাছাইয়ের জন্য কুকি ব্যবহার করতে পারে। বিজ্ঞাপনের পছন্দ বদলাতে <a href="https://adssettings.google.com/">গুগলের বিজ্ঞাপন সেটিংস</a> এবং অংশগ্রহণকারী সংস্থার ব্যক্তিগতকৃত বিজ্ঞাপন বন্ধ করতে <a href="https://www.aboutads.info/choices/">বিজ্ঞাপন পছন্দ নিয়ন্ত্রণের পাতা</a> দেখুন।</p>
    <p>গোপনীয়তা নিয়ে প্রশ্ন থাকলে লিখুন <a href={`mailto:${publicEmail}`}>{publicEmail}</a>।</p>
  </section>}
  {page.slug === 'contact' && <section class="section card" aria-label="যোগাযোগ">
    <p>তারিখ বা তিথির ভুল, সাইট নিয়ে মতামত কিংবা সাধারণ প্রশ্ন জানাতে ইমেল করুন।</p>
    <p><a href={`mailto:${publicEmail}`}>{publicEmail}</a></p>
    <p>সংশোধনের জন্য লিখলে পাতার ঠিকানা, সংশ্লিষ্ট তারিখ ও তথ্যসূত্র দিন।</p>
  </section>}
  {page.slug === 'terms' && <section class="section card" aria-label="ব্যবহারের শর্ত">
    <p>বঙ্গপঞ্জির পঞ্জিকা ও বর্ষপঞ্জি সাধারণ তথ্যের জন্য দেওয়া হয়। পঞ্জিকার তারিখ উল্লেখিত তথ্যসূত্রের সঙ্গে মিলিয়ে যাচাই হলে প্রকাশ করা হয়। যাচাই না হওয়া তারিখ প্রকাশ করা হয় না।</p>
    <p>প্রকাশিত তথ্যের নির্ভুলতা, সম্পূর্ণতা বা সব সময় পাওয়া যাওয়ার কোনো নিশ্চয়তা দেওয়া হয় না। ধর্মীয় আচারের দিন ঠিক করার সময় আপনার পরিবার বা সম্প্রদায়ের অনুসৃত পঞ্জিকা ও রীতি মিলিয়ে দেখুন।</p>
    <p>উৎস হিসেবে বঙ্গপঞ্জির নাম এবং মূল পাতার লিংক দিয়ে বঙ্গপঞ্জির নিজস্ব লেখা ও তথ্য ভাগ করতে পারেন। অন্য উৎসের উপকরণে সংশ্লিষ্ট উৎসের শর্ত প্রযোজ্য।</p>
  </section>}
</Layout>
